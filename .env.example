# ── Outgoing email (Titan Mail SMTP) ─────────────────────────────────────
# Powers the enquiry-form auto-reply, payment receipts, the payment-failed
# admin alert, and the daily digest. Sends straight through your existing
# Titan Mail mailbox (e.g. info@ateknonsolutions.com) via SMTP — no separate
# email-service account or sender-domain verification needed, and every
# email you send lands in that mailbox's own Sent folder.
#   1. In Titan's webmail (usually accessible from your domain host's email
#      dashboard) confirm your outgoing mail server: Settings → look for
#      "SMTP" or "Outgoing Mail Server". It's typically smtp.titan.email on
#      port 465 — the defaults below assume that; only change SMTP_HOST /
#      SMTP_PORT if your provider shows different values.
#   2. SMTP_USER is the full mailbox address (e.g. info@ateknonsolutions.com).
#   3. SMTP_PASSWORD is that mailbox's password. As sensitive as any other
#      secret here — never commit it, never expose it to the browser.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=A Teknon Solutions

# ── Supabase (auth + database) ───────────────────────────────────────────
# Create a free project at https://supabase.com/dashboard
# Project Settings → API gives you all three values below.
#
# VITE_-prefixed vars are exposed to the browser bundle by Vite — that's
# expected and safe for the URL and anon key (they're meant to be public;
# Supabase's Row Level Security policies, not secrecy, are what protect data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# service_role key — NEVER prefix this with VITE_, never expose it to the
# browser. Only used inside /api serverless functions. Full-access, bypasses
# Row Level Security — treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=

# ── @supabase/server (used by api/whoami.js) ─────────────────────────────
# Newer key format from Project Settings → API Keys. SUPABASE_SECRET_KEY is
# as sensitive as SUPABASE_SERVICE_ROLE_KEY above — never expose it either.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── Payments (Razorpay) ───────────────────────────────────────────────────
# Sign up free at https://dashboard.razorpay.com/signup. Start in Test Mode
# (Settings → API Keys → Generate Test Key) so you can try the full checkout
# flow with no real money before switching to live keys.
# RAZORPAY_KEY_SECRET is as sensitive as the Supabase service_role key above
# — never expose it to the browser, never commit it. RAZORPAY_KEY_ID is
# public (the client-side checkout widget needs it) but is only ever sent
# to the browser via /api/create-order's response, not as a VITE_ var.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended once you're taking real payments: Settings →
# Webhooks → Add New Webhook, URL https://yoursite.com/api/razorpay-webhook,
# subscribe to "payment.captured", and put the webhook secret it gives you
# here. This is a reliability backstop (catches a payment that succeeded but
# whose confirmation call from the browser never arrived) — checkout works
# without it, just slightly less robust against a closed tab mid-payment.
RAZORPAY_WEBHOOK_SECRET=

# ── Daily admin digest (Vercel Cron) ─────────────────────────────────────
# Optional but recommended. Once set, Vercel automatically sends this exact
# value as an Authorization: Bearer header on every scheduled call to
# /api/cron/daily-digest — without it, that endpoint still works but isn't
# protected against being triggered by anyone who finds the URL. Any long
# random string works; generate one with `openssl rand -hex 32`.
CRON_SECRET=
